# Vercel Blob — private storage for uploaded plans.
# Created automatically when you connect a Blob store to the project in Vercel.
BLOB_READ_WRITE_TOKEN=

# Resend (https://resend.com) — sends quote requests to Murray.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "ProQS website <quotes@proqs.co.nz>"
QUOTE_FROM_EMAIL=
# Optional: defaults to murray@proqs.co.nz
QUOTE_TO_EMAIL=
